{
  "name": "@tidelight/sdk",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Official TypeScript client for Tidelight Intelligence Cloud API v1.",
  "homepage": "https://tidelight.app/developers/packages/sdk",
  "bugs": {
    "url": "https://github.com/TidelightOrg/tidelight/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TidelightOrg/tidelight.git",
    "directory": "sdk/typescript"
  },
  "keywords": [
    "tidelight",
    "sdk",
    "market-intelligence",
    "research",
    "webhooks"
  ]
}
